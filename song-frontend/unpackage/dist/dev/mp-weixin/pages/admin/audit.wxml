<view class="container"><view class="header"><text class="title">歌手审核</text><text class="subtitle">Pending Applications</text></view><view class="tabs"><view class="tab-item active">{{"待审核 ("+$root.g0+")"}}</view><view class="tab-item">已审核</view></view><view class="audit-list"><block wx:for="{{pendingList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="audit-card"><view class="card-header"><view class="user-info"><text class="user-name">{{item.realName}}</text><text class="user-meta">{{"申请艺名: "+item.stageName}}</text></view><text class="time">{{item.time}}</text></view><view class="card-body"><view class="info-row"><text class="label">手机号:</text><text class="value">{{item.phone}}</text></view><view class="info-row"><text class="label">年龄:</text><text class="value">{{item.age}}</text></view><view class="info-row"><text class="label">邮箱:</text><text class="value">{{item.email}}</text></view></view><view class="card-footer"><button data-event-opts="{{[['tap',[['handleReject',[index]]]]]}}" class="btn btn-reject" bindtap="__e">拒绝</button><button data-event-opts="{{[['tap',[['handleApprove',[index]]]]]}}" class="btn btn-approve" bindtap="__e">通过</button></view></view></block><block wx:if="{{$root.g1===0}}"><view class="empty-state"><text>暂无待审核申请</text></view></block></view></view>