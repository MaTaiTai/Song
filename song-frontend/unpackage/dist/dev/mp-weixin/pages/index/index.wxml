<view class="container"><view class="header"><view class="title"><text class="title-main">同仁四季</text><text class="title-sub">Music & Coconut Chicken</text></view><view class="search-bar"><text class="search-placeholder">搜索歌手或歌曲...</text></view></view><view class="section-title">今日驻唱</view><scroll-view class="singer-scroll" scroll-x="true"><block wx:for="{{singers}}" wx:for-item="singer" wx:for-index="index" wx:key="index"><view class="singer-card"><view class="singer-avatar" style="{{'background-color:'+(singer.color)+';'}}"><text class="singer-initial">{{singer.name[0]}}</text></view><text class="singer-name">{{singer.name}}</text><text class="singer-style">{{singer.style}}</text></view></block></scroll-view><view class="section-title">热门歌单</view><view class="song-list"><block wx:for="{{songs}}" wx:for-item="song" wx:for-index="index" wx:key="index"><view class="song-item"><view class="song-info"><text class="song-name">{{song.name}}</text><text class="song-artist">{{song.artist}}</text></view><view class="song-action"><text class="song-price">{{"¥"+song.price}}</text><button class="btn-order">点歌</button></view></view></block></view></view>