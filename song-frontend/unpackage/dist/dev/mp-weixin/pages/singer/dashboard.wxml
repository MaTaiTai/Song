<view class="container"><view class="profile-header"><view class="avatar"><text class="avatar-text">S</text></view><view class="profile-info"><text class="singer-name">Jason (驻场)</text><text class="singer-status">状态: 在线接单中</text></view><view class="settings-btn"><text class="settings-icon">⚙️</text></view></view><view class="income-card"><view class="income-row"><view class="income-item"><text class="income-label">今日收益 (元)</text><text class="income-value">¥320.00</text></view><view class="income-item"><text class="income-label">累计收益 (元)</text><text class="income-value small">¥12,450.00</text></view></view><button class="btn-withdraw">申请提现</button></view><view class="action-grid"><view data-event-opts="{{[['tap',[['uploadSong',['$event']]]]]}}" class="action-item" bindtap="__e"><view class="action-icon add">+</view><text class="action-text">上传新歌</text></view><view class="action-item"><view class="action-icon">📝</view><text class="action-text">歌单管理</text></view><view class="action-item"><view class="action-icon">💬</view><text class="action-text">互动留言</text></view><view class="action-item"><view class="action-icon">📊</view><text class="action-text">数据分析</text></view></view><view class="section-title">我的歌单 (已上架)</view><view class="song-list"><block wx:for="{{mySongs}}" wx:for-item="song" wx:for-index="index" wx:key="index"><view class="song-item"><view class="song-info"><text class="song-name">{{song.name}}</text><text class="song-price">{{"¥"+song.price}}</text></view><view class="song-controls"><switch style="transform:scale(0.7);" checked="{{song.active}}" color="#FFD700"></switch><text class="edit-btn">编辑</text></view></view></block></view></view>